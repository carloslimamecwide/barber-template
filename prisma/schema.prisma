generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusAgendamento {
  agendado
  concluido
  cancelado
  faltou
}

enum StatusProposta {
  pendente
  confirmada
  recusada
  expirada
}

enum SerieEstado {
  ativa
  cancelada
}

enum UserRole {
  admin
  rececao
  profissional
}

enum TipoNotificacao {
  confirmacao
  proposta
  lembrete
}

enum EstadoNotificacao {
  pendente
  processando
  enviada
  falhada
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  passwordHash     String
  ativo            Boolean       @default(true)
  tentativasFalhas Int           @default(0)
  bloqueadoAte     DateTime?     @db.Timestamptz(3)
  role             UserRole      @default(admin)
  profissionalId   String?       @unique
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  profissional     Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  auditorias       AuditLog[]
}

model Profissional {
  id           String                 @id @default(cuid())
  nome         String
  telefone     String?
  email        String?
  ativo        Boolean                @default(true)
  ordem        Int                    @default(0)
  criadoEm     DateTime               @default(now()) @db.Timestamptz(3)
  agendamentos Agendamento[]
  series       SerieRecorrente[]
  utilizador   User?
  horarios     HorarioProfissional[]
  ausencias    AusenciaProfissional[]
  servicos     ServicoProfissional[]

  @@index([ativo, ordem])
}

model Cliente {
  id               String            @id @default(cuid())
  nome             String
  telefone         String
  email            String?
  emailNormalizado String?           @unique
  notas            String?
  ativo            Boolean           @default(true)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  agendamentos     Agendamento[]
  series           SerieRecorrente[]

  @@index([ativo, nome])
}

model Servico {
  id           String                @id @default(cuid())
  nome         String
  precoCents   Int
  duracaoMin   Int
  ativo        Boolean               @default(true)
  agendamentos Agendamento[]
  series       SerieRecorrente[]
  servicos     ServicoProfissional[]

  @@index([ativo, nome])
}

model Agendamento {
  id                  String                  @id @default(cuid())
  clienteId           String
  servicoId           String
  profissionalId      String
  dataHora            DateTime                @db.Timestamptz(3)
  status              StatusAgendamento       @default(agendado)
  precoCobrado        Int
  duracaoAgendadaMin  Int
  notas               String?
  criadoEm            DateTime                @default(now()) @db.Timestamptz(3)
  atualizadoEm        DateTime                @updatedAt @db.Timestamptz(3)
  versao              Int                     @default(1)
  motivoStatus        String?
  tokenGestaoHash     String?                 @unique
  tokenGestaoExpiraEm DateTime?               @db.Timestamptz(3)
  serieId             String?
  lembreteEnviadoEm   DateTime?               @db.Timestamptz(3)
  excecaoManual       Boolean                 @default(false)
  motivoExcecao       String?
  arquivadoEm         DateTime?               @db.Timestamptz(3)
  cliente             Cliente                 @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  servico             Servico                 @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  profissional        Profissional            @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  serie               SerieRecorrente?        @relation(fields: [serieId], references: [id], onDelete: SetNull)
  propostas           PropostaReagendamento[]
  notificacoes        Notificacao[]
  idempotencia        Idempotencia?

  @@unique([serieId, dataHora])
  @@index([dataHora])
  @@index([clienteId])
  @@index([servicoId])
  @@index([profissionalId, dataHora])
  @@index([serieId])
  @@index([status, dataHora])
}

model PropostaReagendamento {
  id            String         @id @default(cuid())
  agendamentoId String
  tokenHash     String         @unique
  dataHoraAtual DateTime       @db.Timestamptz(3)
  novaDataHora  DateTime       @db.Timestamptz(3)
  status        StatusProposta @default(pendente)
  expiraEm      DateTime       @db.Timestamptz(3)
  criadaEm      DateTime       @default(now()) @db.Timestamptz(3)
  respondidaEm  DateTime?      @db.Timestamptz(3)
  agendamento   Agendamento    @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([agendamentoId, status])
  @@index([expiraEm, status])
}

model SerieRecorrente {
  id               String         @id @default(cuid())
  clienteId        String
  servicoId        String
  profissionalId   String?
  diaDaSemana      Int
  hora             String
  intervaloSemanas Int            @default(1)
  dataInicio       DateTime       @db.Date
  estado           SerieEstado    @default(ativa)
  canceladaEm      DateTime?      @db.Timestamptz(3)
  criadaEm         DateTime       @default(now()) @db.Timestamptz(3)
  cliente          Cliente        @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  servico          Servico        @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  profissional     Profissional?  @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  agendamentos     Agendamento[]
  excecoes         ExcecaoSerie[]

  @@index([clienteId])
  @@index([servicoId])
  @@index([profissionalId])
  @@index([estado])
}

model ExcecaoSerie {
  id          String          @id @default(cuid())
  serieId     String
  dataHora    DateTime        @db.Timestamptz(3)
  motivo      String
  resolvidaEm DateTime?       @db.Timestamptz(3)
  criadaEm    DateTime        @default(now()) @db.Timestamptz(3)
  serie       SerieRecorrente @relation(fields: [serieId], references: [id], onDelete: Cascade)

  @@unique([serieId, dataHora])
  @@index([resolvidaEm])
}

model Notificacao {
  id                 String            @id @default(cuid())
  agendamentoId      String?
  tipo               TipoNotificacao
  estado             EstadoNotificacao @default(pendente)
  destinatario       String
  payload            Json
  tentativas         Int               @default(0)
  proximaTentativaEm DateTime          @default(now()) @db.Timestamptz(3)
  ultimoErro         String?
  criadaEm           DateTime          @default(now()) @db.Timestamptz(3)
  enviadaEm          DateTime?         @db.Timestamptz(3)
  agendamento        Agendamento?      @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)

  @@index([estado, proximaTentativaEm])
  @@index([agendamentoId, tipo])
}

model HorarioFuncionamento {
  id          String  @id @default(cuid())
  diaDaSemana Int     @unique
  aberto      Boolean @default(false)
  abertura    String?
  fecho       String?
  pausaInicio String?
  pausaFim    String?
}

model DiaFechado {
  id     String   @id @default(cuid())
  data   DateTime @unique @db.Date
  motivo String?
}

model ConfiguracaoBarbearia {
  id                   String   @id @default("principal")
  nome                 String   @default("Barbearia Nobre")
  timezone             String   @default("Europe/Lisbon")
  intervaloSlotsMin    Int      @default(15)
  antecedenciaMinHoras Int      @default(2)
  horizonteDias        Int      @default(90)
  cancelamentoMinHoras Int      @default(24)
  lembreteHoras        Int      @default(24)
  atualizadoEm         DateTime @updatedAt @db.Timestamptz(3)
}

model HorarioProfissional {
  id             String       @id @default(cuid())
  profissionalId String
  diaDaSemana    Int
  ativo          Boolean      @default(true)
  abertura       String
  fecho          String
  pausaInicio    String?
  pausaFim       String?
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@unique([profissionalId, diaDaSemana])
  @@index([profissionalId, ativo])
}

model AusenciaProfissional {
  id             String       @id @default(cuid())
  profissionalId String
  inicio         DateTime     @db.Timestamptz(3)
  fim            DateTime     @db.Timestamptz(3)
  motivo         String?
  criadoEm       DateTime     @default(now()) @db.Timestamptz(3)
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId, inicio, fim])
}

model ServicoProfissional {
  profissionalId String
  servicoId      String
  precoCents     Int?
  duracaoMin     Int?
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  servico        Servico      @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@id([profissionalId, servicoId])
  @@index([servicoId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  acao       String
  entidade   String
  entidadeId String?
  dados      Json?
  ip         String?
  criadoEm   DateTime @default(now()) @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entidade, entidadeId])
  @@index([criadoEm])
  @@index([userId, criadoEm])
}

model Idempotencia {
  chave         String       @id
  requestHash   String
  agendamentoId String?      @unique
  criadaEm      DateTime     @default(now()) @db.Timestamptz(3)
  expiraEm      DateTime     @db.Timestamptz(3)
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([expiraEm])
}

model LimiteAcesso {
  chave        String   @id
  tentativas   Int      @default(0)
  janelaInicio DateTime @default(now()) @db.Timestamptz(3)
  expiraEm     DateTime @db.Timestamptz(3)

  @@index([expiraEm])
}

model ExecucaoCron {
  id        String    @id @default(cuid())
  inicio    DateTime  @default(now()) @db.Timestamptz(3)
  fim       DateTime? @db.Timestamptz(3)
  sucesso   Boolean?
  resultado Json?
  erro      String?

  @@index([inicio])
}
